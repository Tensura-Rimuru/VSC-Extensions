{
  "name": "rust-precise-folding",
  "displayName": "Rust Precise Folding",
  "description": "Focused Rust folding for comments, functions, methods, and Rust brace blocks.",
  "version": "0.2.1",
  "publisher": "Tensura-Rimuru",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tensura-Rimuru/VSC-Extensions.git",
    "directory": "rust-precise-folding"
  },
  "engines": {
    "vscode": ">=1.90.0"
  },
  "activationEvents": [
    "onLanguage:rust",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -p ./tsconfig.json --watch",
    "test:compile": "tsc -p ./tsconfig.test.json",
    "test": "npm run compile && npm run test:compile && node --test dist-test/test/folding.test.js dist-test/test/packaging.test.js",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  },
  "contributes": {
    "configurationDefaults": {
      "[rust]": {
        "editor.defaultFoldingRangeProvider": "Tensura-Rimuru.rust-precise-folding",
        "editor.foldingStrategy": "auto"
      }
    }
  }
}
